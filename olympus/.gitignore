# Olympus MVP — keep the PUBLIC GitHub Pages repo (~/agent) free of real holdings & local data.
#
# Real-money holdings must NEVER be committable. The example core in
# olympus/config/portfolio_policy.yaml IS committed (so the slice runs); real holdings go in a
# gitignored override file that Hecate prefers when present.

# --- Real / personal holdings (never commit) ---
portfolio_policy.real.yaml
portfolio_policy.real.yml
*.real.yaml
*.real.yml
*_real*.yaml
*_real*.yml
*.local.yaml

# --- Local runtime data artifacts (ledgers, generated reports — regenerated, not source) ---
data/

# --- caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
